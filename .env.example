# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://samanvay:samanvay@localhost:5432/samanvay
JWT_SECRET=<long random string>

# Email. Gmail SMTP locally; on hosts that block SMTP (Render free) set BREVO_API_KEY instead.
# BREVO_API_KEY=<key from brevo.com; verify the SMTP_FROM address there>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sender address>
SMTP_PASS=<Gmail app password, only in .env>
SMTP_FROM=SAMANVAY demo <<sender address>>
SMTP_STARTTLS=true
# Every demo role's mail goes here via plus-addressing (+officer, +head, +coordinator, +management, +admin)
TEST_ALERT_EMAIL=<sender address>

PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4180
DEMO_MODE=true
DEMO_PASSWORD=<demo password>
APP_ENV=development
COOKIE_SECURE=false
# SMS: leave empty. No SMS gateway is connected (see backend/app/services/sms.py).
SMS_PROVIDER=
